CFILES=$(SBDIR)softbound-checks.c $(SBDIR)softbound.c $(SBDIR)softbound-wrappers.c $(CTESTS)
BCFILES=$(CFILES:.c=.bc)
BCTESTS=$(CTESTS:.c=.bc)
COPTS=-c --emit-llvm -O3 -D__SOFTBOUND_TRIE $(EXTRA_COPTS)
LDOPTS=$(EXTRA_LDOPTS)

all: $(BCFILES) test

%.bc: %.c
	gcc $(COPTS) $< -o $@

test: $(BCFILES)
	llvm-ld -disable-opt -mem2reg -lowerswitch $(BCTESTS) -o test
	llvm-link $(SBDIR)softbound-checks.bc test.bc > test-linked.bc
	llvm-dis -f test-linked.bc
	opt -disable-opt -mem2reg -SoftBoundPass -load_opt=false -global_const_opt=false test-linked.bc > test-instrumented.bc
	llvm-dis -f test-instrumented.bc
	llvm-link test-instrumented.bc $(SBDIR)softbound.bc $(SBDIR)softbound-wrappers.bc > test-softbound.bc
	llvm-dis -f test-softbound.bc
	llvm-ld -native -lm -lcrypt test-softbound.bc -o test
	llvm-dis -f test-linked.bc
	llvm-dis -f test-instrumented.bc
 
clean:
	rm -rf *.bc test test-softbound.ll
