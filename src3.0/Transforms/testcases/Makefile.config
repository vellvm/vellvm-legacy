LLVM=/home/jianzhou/Tools/llvm-3.0/
LD=$(LLVM)/bin/llvm-ld

CFILES=$(CTESTS)
BCFILES=$(CFILES:.c=.bc)
BCTESTS=$(CTESTS:.c=.bc)
NOWARNINGS=-Wno-extra-tokens -Wno-implicit-function-declaration \
	   -Wno-implicit-int -Wno-logical-op-parentheses \
	   -Wno-return-type -Wno-format-extra-args -Wno-parentheses \
	   -Wno-bitwise-op-parentheses -Wno-pointer-sign -Wno-format \
	   -Wno-tautological-compare -Wno-incompatible-pointer-types
COPTS=$(NOWARNINGS) -c -emit-llvm -O0 $(EXTRA_COPTS)
LDOPTS=$(EXTRA_LDOPTS)

all: $(BCFILES) test

%.bc: %.c
	clang $(COPTS) $< -o $@

test: $(BCFILES)
	#$(LD) -disable-opt -mem2reg -lowerswitch $(BCTESTS) -o test
	$(LD) -disable-opt -lowerswitch $(BCTESTS) -o test

clean:
	rm -rf *.bc test
